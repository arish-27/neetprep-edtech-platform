# For local dev, the Vite dev server proxies `/api/*` to the backend (see `vite.config.ts`),
# so a relative base URL avoids CORS issues.
VITE_API_URL=/api/v1
# Backend origin for Vite proxy target (defaults to http://localhost:8001)
# VITE_BACKEND_ORIGIN=http://localhost:8001
# Optional: enables video metadata (title/duration) lookups.
# VITE_YOUTUBE_API_KEY=your_key_here

# Google Gemini AI — get your key at https://aistudio.google.com/app/apikey
# Free tier: gemini-1.5-flash — 15 RPM, 1M TPM, 1500 RPD
VITE_GEMINI_API_KEY=your_gemini_api_key_here
